<button id="theme-toggle" type="button" aria-label="Switch colour theme">
	<span class="to-dark">Dark</span>
	<span class="to-light">Light</span>
</button>

<style>
	button {
		background: none;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: rgb(var(--gray));
		cursor: pointer;
		font-family: inherit;
		font-size: 0.85em;
		padding: 0.3em 0.9em;
	}
	button:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.to-light {
		display: none;
	}
	:global(:root[data-theme='dark']) .to-dark {
		display: none;
	}
	:global(:root[data-theme='dark']) .to-light {
		display: inline;
	}
</style>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>